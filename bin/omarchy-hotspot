#!/bin/bash

# omarchy:summary=Wi-Fi Hotspot & Internet Sharing/Repeater backend for Omarchy
# omarchy:group=hotspot
# omarchy:args=[status|start|stop|toggle|clients|qr|save-config]

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
CONFIG_FILE="$CONFIG_DIR/hotspot.json"
PROFILE_NAME="OmarchyHotspot"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Default configuration getter
get_config() {
  local key="$1"
  local default_val="$2"
  if [[ -f "$CONFIG_FILE" ]]; then
    val=$(jq -r --arg k "$key" '.[$k] // empty' "$CONFIG_FILE" 2>/dev/null || true)
    if [[ -n "$val" ]]; then
      echo "$val"
      return
    fi
  fi
  echo "$default_val"
}

# Save configuration
save_config() {
  local ssid="$1"
  local password="$2"
  local band="${3:-bg}"
  local channel="${4:-0}"
  local security="${5:-wpa-psk}"
  local upstream_pref="${6:-auto}"

  jq -n \
    --arg ssid "$ssid" \
    --arg password "$password" \
    --arg band "$band" \
    --arg channel "$channel" \
    --arg security "$security" \
    --arg upstream_pref "$upstream_pref" \
    '{
      ssid: $ssid,
      password: $password,
      band: $band,
      channel: $channel,
      security: $security,
      upstream_preference: $upstream_pref
    }' > "$CONFIG_FILE"
}

# Find primary Wi-Fi interface (STA client)
get_primary_wifi() {
  local iface
  iface=$(iw dev 2>/dev/null | awk '$1 == "Interface" && $2 ~ /^wl/ { print $2; exit }')
  if [[ -z "$iface" ]]; then
    iface=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" && $1 ~ /^wl/ { print $1; exit }')
  fi
  echo "${iface:-wlo1}"
}

# Find or ensure AP interface name
get_ap_iface() {
  if ip link show ap0 >/dev/null 2>&1; then
    echo "ap0"
    return
  fi
  local p
  p=$(get_primary_wifi)
  echo "${p:-wlo1}"
}

# Detect upstream internet connection details
get_upstream_info() {
  local pref
  pref=$(get_config "upstream_preference" "auto")
  
  local eth_iface
  eth_iface=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: '$2 == "ethernet" && $3 ~ /^connected/ { print $1; exit }')
  local eth_ip=""
  [[ -n "$eth_iface" ]] && eth_ip=$(ip -4 addr show dev "$eth_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')

  local wifi_iface
  wifi_iface=$(get_primary_wifi)
  local wifi_connected=false
  local wifi_ssid=""
  local wifi_ip=""
  if iw dev "$wifi_iface" info 2>/dev/null | grep -q "type managed"; then
    wifi_ssid=$(iw dev "$wifi_iface" info 2>/dev/null | awk '$1 == "ssid" { print $2; exit }')
    if [[ -z "$wifi_ssid" ]]; then
      wifi_ssid=$(nmcli -t -f DEVICE,CONNECTION device status 2>/dev/null | awk -F: -v dev="$wifi_iface" '$1 == dev && $2 != "" && $2 != "--" { print $2; exit }')
    fi
    if [[ -n "$wifi_ssid" ]]; then
      wifi_connected=true
      wifi_ip=$(ip -4 addr show dev "$wifi_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')
    fi
  fi

  local active_iface=""
  local active_type="none"
  local active_ip=""
  local active_name=""

  if [[ "$pref" == "ethernet" && -n "$eth_iface" ]]; then
    active_iface="$eth_iface"
    active_type="ethernet"
    active_ip="$eth_ip"
    active_name="Ethernet"
  elif [[ "$pref" == "wifi" && "$wifi_connected" == "true" ]]; then
    active_iface="$wifi_iface"
    active_type="wifi"
    active_ip="$wifi_ip"
    active_name="$wifi_ssid"
  else
    # Auto mode: check default route
    local route_dev
    route_dev=$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i=1; i<=NF; i++) if ($i == "dev") { print $(i+1); exit } }')
    if [[ -n "$route_dev" ]]; then
      active_iface="$route_dev"
      if [[ "$active_iface" == "$eth_iface" ]]; then
        active_type="ethernet"
        active_ip="$eth_ip"
        active_name="Ethernet"
      elif [[ "$active_iface" == "$wifi_iface" ]]; then
        active_type="wifi"
        active_ip="$wifi_ip"
        active_name="$wifi_ssid"
      else
        active_type="other"
        active_ip=$(ip -4 addr show dev "$active_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')
        active_name="$active_iface"
      fi
    elif [[ -n "$eth_iface" ]]; then
      active_iface="$eth_iface"
      active_type="ethernet"
      active_ip="$eth_ip"
      active_name="Ethernet"
    elif [[ "$wifi_connected" == "true" ]]; then
      active_iface="$wifi_iface"
      active_type="wifi"
      active_ip="$wifi_ip"
      active_name="$wifi_ssid"
    fi
  fi

  # Build dynamic upstreams list containing only active/connected interfaces
  local upstreams_json="[]"
  local items=()

  # Always include Auto
  items+=("{\"id\": \"auto\", \"label\": \"Automático (Recomendado)\", \"available\": true, \"selected\": $( [[ "$pref" == "auto" ]] && echo true || echo false )}")

  if [[ -n "$eth_iface" ]]; then
    items+=("{\"id\": \"ethernet\", \"label\": \"Ethernet (${eth_ip:-$eth_iface})\", \"available\": true, \"selected\": $( [[ "$pref" == "ethernet" ]] && echo true || echo false )}")
  fi

  if [[ "$wifi_connected" == "true" ]]; then
    items+=("{\"id\": \"wifi\", \"label\": \"Wi-Fi (${wifi_ssid:-$wifi_iface})\", \"available\": true, \"selected\": $( [[ "$pref" == "wifi" ]] && echo true || echo false )}")
  fi

  if [[ ${#items[@]} -gt 0 ]]; then
    upstreams_json=$(IFS=,; echo "[${items[*]}]")
  fi

  echo "$active_iface|$active_type|$active_ip|$active_name|$pref|$upstreams_json"
}

# Check if hotspot profile is currently active
is_hotspot_active() {
  # Check if NetworkManager active connection list has OmarchyHotspot
  if nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null | grep -E "^${PROFILE_NAME}:802-11-wireless:activated" >/dev/null 2>&1; then
    return 0
  fi
  # Also check if an AP-mode interface is currently running the profile
  local ap_dev
  ap_dev=$(nmcli -t -f DEVICE,CONNECTION,STATE device status 2>/dev/null | awk -F: -v prof="$PROFILE_NAME" '$2 == prof && $3 ~ /^connected/ { print $1; exit }')
  if [[ -n "$ap_dev" ]]; then
    return 0
  fi
  return 1
}

# Generate QR Matrix (square 0/1 array for QML)
generate_qr_matrix() {
  local ssid="$1"
  local password="$2"
  local security="$3"

  local sec_type="WPA"
  if [[ "$security" == "open" || -z "$password" ]]; then
    sec_type="nopass"
  fi

  local esc_ssid
  esc_ssid=$(printf '%s' "$ssid" | sed -e 's/\\/\\\\/g' -e 's/;/\\;/g' -e 's/,/\\,/g' -e 's/:/\\:/g')
  local esc_pw
  esc_pw=$(printf '%s' "$password" | sed -e 's/\\/\\\\/g' -e 's/;/\\;/g' -e 's/,/\\,/g' -e 's/:/\\:/g')

  local payload="WIFI:T:${sec_type};S:${esc_ssid};P:${esc_pw};;"
  if [[ "$sec_type" == "nopass" ]]; then
    payload="WIFI:T:nopass;S:${esc_ssid};;"
  fi

  if command -v qrencode >/dev/null 2>&1; then
    local ascii
    ascii=$(printf '%s' "$payload" | qrencode --type ASCII --margin 2 --output - 2>/dev/null || true)
    if [[ -n "$ascii" ]]; then
      local rows=()
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local row=""
        for (( col=0; col<${#line}; col+=2 )); do
          if [[ "${line:col:2}" == *"#"* ]]; then
            row+="1"
          else
            row+="0"
          fi
        done
        rows+=("\"$row\"")
      done <<< "$ascii"
      
      local size=${#rows[@]}
      local matrix_json
      matrix_json=$(IFS=,; echo "[${rows[*]}]")
      echo "{\"size\": $size, \"rows\": $matrix_json, \"payload\": \"$payload\"}"
      return
    fi
  fi

  echo "{\"size\": 0, \"rows\": [], \"payload\": \"$payload\"}"
}

# Get list of connected clients
get_clients() {
  local iface="$1"
  local clients_json="[]"

  if [[ -z "$iface" ]] || ! ip link show "$iface" >/dev/null 2>&1; then
    echo "$clients_json"
    return
  fi

  declare -A st_signal st_rx st_tx st_time
  local current_mac=""

  while IFS= read -r line; do
    if [[ "$line" =~ ^Station[[:space:]]+([0-9a-fA-F:]{17}) ]]; then
      current_mac="${BASH_REMATCH[1]}"
      st_signal["$current_mac"]="-60"
      st_rx["$current_mac"]="0"
      st_tx["$current_mac"]="0"
      st_time["$current_mac"]="0"
    elif [[ -n "$current_mac" ]]; then
      if [[ "$line" =~ signal:[[:space:]]*([-\.0-9]+) ]]; then
        st_signal["$current_mac"]="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ rx[[:space:]]+bytes:[[:space:]]*([0-9]+) ]]; then
        st_rx["$current_mac"]="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ tx[[:space:]]+bytes:[[:space:]]*([0-9]+) ]]; then
        st_tx["$current_mac"]="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ connected[[:space:]]+time:[[:space:]]*([0-9]+) ]]; then
        st_time["$current_mac"]="${BASH_REMATCH[1]}"
      fi
    fi
  done < <(iw dev "$iface" station dump 2>/dev/null || true)

  declare -A ip_map host_map

  # First pass: map IPv4 specifically from arp / ip -4 neigh
  while IFS= read -r line; do
    local ip=$(echo "$line" | awk '{print $1}')
    local mac=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}')
    if [[ -n "$mac" && -n "$ip" ]]; then
      ip_map["$mac"]="$ip"
    fi
  done < <(ip -4 neigh show dev "$iface" 2>/dev/null | grep -E "10\.42\.0\." || true)

  # Fallback pass for any remaining
  while IFS= read -r line; do
    local ip=$(echo "$line" | awk '{print $1}')
    local mac=$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}')
    if [[ -n "$mac" && -n "$ip" && -z "${ip_map[$mac]:-}" ]]; then
      ip_map["$mac"]="$ip"
    fi
  done < <(ip neigh show dev "$iface" 2>/dev/null || true)

  local items=()
  for mac in "${!st_signal[@]}"; do
    local ip="${ip_map[$mac]:-unknown}"
    local hostname=""
    if [[ "$ip" != "unknown" ]]; then
      hostname=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}' || true)
      if [[ -z "$hostname" ]]; then
        hostname=$(avahi-resolve -a "$ip" 2>/dev/null | awk '{print $2}' || true)
      fi
    fi
    [[ -z "$hostname" ]] && hostname="$mac"

    local sig="${st_signal[$mac]:--60}"
    local rx="${st_rx[$mac]:-0}"
    local tx="${st_tx[$mac]:-0}"
    local time="${st_time[$mac]:-0}"

    items+=("$(jq -n \
      --arg mac "$mac" \
      --arg ip "$ip" \
      --arg hostname "$hostname" \
      --argjson signal "$sig" \
      --argjson rx_bytes "$rx" \
      --argjson tx_bytes "$tx" \
      --argjson connected_seconds "$time" \
      '{mac: $mac, ip: $ip, hostname: $hostname, signal: $signal, rx_bytes: $rx_bytes, tx_bytes: $tx_bytes, connected_seconds: $connected_seconds}')")
  done

  if [[ ${#items[@]} -gt 0 ]]; then
    clients_json=$(IFS=,; echo "[${items[*]}]")
  fi

  echo "$clients_json"
}

# Status command
cmd_status() {
  local ap_iface
  ap_iface=$(get_ap_iface)
  
  local active=false
  local ip=""
  local clients="[]"
  local clients_count=0
  local actual_ssid=""
  local actual_band=""
  local actual_channel=""

  # Upstream info
  IFS='|' read -r up_iface up_type up_ip up_name up_pref up_list <<< "$(get_upstream_info)"

  # Saved / Configured values
  local default_ssid="Omarchy-$(hostname 2>/dev/null || echo 'Hotspot')"
  local conf_ssid
  conf_ssid=$(get_config "ssid" "$default_ssid")
  local conf_pw
  conf_pw=$(get_config "password" "omarchy1234")
  local conf_band
  conf_band=$(get_config "band" "bg")
  local conf_chan
  conf_chan=$(get_config "channel" "0")
  local conf_sec
  conf_sec=$(get_config "security" "wpa-psk")
  local conf_up_pref
  conf_up_pref=$(get_config "upstream_preference" "auto")

  if is_hotspot_active; then
    active=true
    ip=$(ip -4 addr show dev "$ap_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')
    
    mapfile -t fields < <(nmcli --show-secrets --escape no --get-values \
      802-11-wireless.ssid,802-11-wireless-security.psk,802-11-wireless.band,802-11-wireless.channel \
      connection show id "$PROFILE_NAME" 2>/dev/null || true)

    actual_ssid="${fields[0]:-$conf_ssid}"
    if [[ -n "${fields[1]:-}" ]]; then
      conf_pw="${fields[1]}"
    fi
    actual_band="${fields[2]:-$conf_band}"
    actual_channel="${fields[3]:-$conf_chan}"

    clients=$(get_clients "$ap_iface")
    clients_count=$(echo "$clients" | jq 'length' 2>/dev/null || echo 0)
  fi

  local qr_info
  qr_info=$(generate_qr_matrix "${actual_ssid:-$conf_ssid}" "$conf_pw" "$conf_sec")

  jq -n \
    --argjson active "$active" \
    --arg ssid "${actual_ssid:-$conf_ssid}" \
    --arg password "$conf_pw" \
    --arg band "${actual_band:-$conf_band}" \
    --arg channel "${actual_channel:-$conf_chan}" \
    --arg security "$conf_sec" \
    --arg upstream_preference "$conf_up_pref" \
    --arg interface "$ap_iface" \
    --arg ip "${ip:-10.42.0.1}" \
    --arg upstream_iface "$up_iface" \
    --arg upstream_type "$up_type" \
    --arg upstream_ip "$up_ip" \
    --arg upstream_name "$up_name" \
    --argjson upstreams "$up_list" \
    --argjson clients_count "$clients_count" \
    --argjson clients "$clients" \
    --argjson qr "$qr_info" \
    '{
      active: $active,
      ssid: $ssid,
      password: $password,
      band: $band,
      channel: $channel,
      security: $security,
      upstream_preference: $upstream_preference,
      interface: $interface,
      ip: $ip,
      upstream: {
        interface: $upstream_iface,
        type: $upstream_type,
        ip: $upstream_ip,
        name: $upstream_name
      },
      upstreams: $upstreams,
      clients_count: $clients_count,
      clients: $clients,
      qr: $qr
    }'
}

# Start Hotspot
cmd_start() {
  local ssid="${1:-}"
  local password="${2:-}"
  local band="${3:-}"
  local channel="${4:-}"
  local security="${5:-}"
  local upstream_pref="${6:-}"

  [[ -z "$ssid" ]] && ssid=$(get_config "ssid" "Omarchy-Hotspot")
  [[ -z "$password" ]] && password=$(get_config "password" "omarchy1234")
  [[ -z "$band" ]] && band=$(get_config "band" "bg")
  [[ -z "$channel" ]] && channel=$(get_config "channel" "0")
  [[ -z "$security" ]] && security=$(get_config "security" "wpa-psk")
  [[ -z "$upstream_pref" ]] && upstream_pref=$(get_config "upstream_preference" "auto")

  save_config "$ssid" "$password" "$band" "$channel" "$security" "$upstream_pref"

  # Ensure Wi-Fi radio is unblocked and powered on so the AP interface can transmit
  if rfkill list wifi 2>/dev/null | grep -q "Soft blocked: yes"; then
    rfkill unblock wifi >/dev/null 2>&1 || true
    sleep 0.5
  fi
  if ! nmcli radio wifi 2>/dev/null | grep -q "enabled"; then
    nmcli radio wifi on >/dev/null 2>&1 || true
    sleep 0.5
  fi

  local primary_wifi
  primary_wifi=$(get_primary_wifi)
  local ap_iface
  ap_iface=$(get_ap_iface)

  # Check if primary wifi is currently connected to an upstream network
  local sta_channel=""
  local sta_band=""
  local is_dfs=false
  if iw dev "$primary_wifi" info 2>/dev/null | grep -q "type managed"; then
    sta_channel=$(iw dev "$primary_wifi" info 2>/dev/null | awk '$1 == "channel" { print $2; exit }')
    if [[ -n "$sta_channel" && "$sta_channel" =~ ^[0-9]+$ ]]; then
      if (( sta_channel > 14 )); then
        sta_band="a"
        # Check if sta_channel is in DFS radar range (52-144) where AP cannot transmit without radar scan
        if (( sta_channel >= 52 && sta_channel <= 144 )); then
          is_dfs=true
        fi
      else
        sta_band="bg"
      fi
    fi
  fi

  local target_channel="$channel"
  local target_band="$band"
  if [[ -n "$sta_channel" ]]; then
    if [[ "$is_dfs" == "true" ]]; then
      # Kernel / hardware cannot run AP on radar DFS channel while in simultaneous client mode.
      # Fallback to standard 2.4GHz band / channel 6
      target_channel="6"
      target_band="bg"
    else
      target_channel="$sta_channel"
      target_band="$sta_band"
    fi
  fi

  # Dynamically ensure virtual AP interface exists on phy0
  if ! ip link show ap0 >/dev/null 2>&1; then
    sudo -n iw phy phy0 interface add ap0 type __ap 2>/dev/null || true
    sudo -n ip link set ap0 up 2>/dev/null || true
    sleep 0.5
  fi

  local ap_iface
  if ip link show ap0 >/dev/null 2>&1; then
    ap_iface="ap0"
  else
    ap_iface=$(get_primary_wifi)
  fi

  # Remove existing profile if any
  if nmcli connection show id "$PROFILE_NAME" >/dev/null 2>&1; then
    nmcli connection delete id "$PROFILE_NAME" >/dev/null 2>&1 || true
  fi

  # Build robust nmcli arguments
  local -a nm_args=(
    type wifi
    ifname "$ap_iface"
    con-name "$PROFILE_NAME"
    autoconnect no
    ssid "$ssid"
    mode ap
  )

  if [[ "$target_band" == "a" || "$target_band" == "bg" || "$target_band" == "6GHz" ]]; then
    nm_args+=(802-11-wireless.band "$target_band")
  fi

  if [[ -n "$target_channel" && "$target_channel" != "0" && "$target_channel" != "auto" ]]; then
    nm_args+=(802-11-wireless.channel "$target_channel")
  fi

  if [[ "$security" == "open" || -z "$password" ]]; then
    nm_args+=(
      ipv4.method shared
      ipv6.method ignore
    )
  else
    nm_args=(
      "${nm_args[@]}"
      802-11-wireless-security.key-mgmt wpa-psk
      802-11-wireless-security.proto rsn
      802-11-wireless-security.pairwise ccmp
      802-11-wireless-security.group ccmp
      802-11-wireless-security.pmf 1
      802-11-wireless-security.psk "$password"
      ipv4.method shared
      ipv6.method ignore
    )
  fi

  nmcli connection add "${nm_args[@]}" >/dev/null

  # Bring connection up on ap0
  nmcli connection up id "$PROFILE_NAME" >/dev/null

  cmd_status
}

# Stop Hotspot
cmd_stop() {
  if is_hotspot_active; then
    nmcli connection down id "$PROFILE_NAME" >/dev/null 2>&1 || true
  fi
  if nmcli connection show id "$PROFILE_NAME" >/dev/null 2>&1; then
    nmcli connection delete id "$PROFILE_NAME" >/dev/null 2>&1 || true
  fi
  # Cleanly delete virtual interface ap0 when stopping hotspot so it leaves wlo1 alone
  if ip link show ap0 >/dev/null 2>&1; then
    sudo -n iw dev ap0 del 2>/dev/null || true
  fi
  cmd_status
}

# Toggle Hotspot
cmd_toggle() {
  if is_hotspot_active; then
    cmd_stop
  else
    cmd_start
  fi
}

# Save configuration
cmd_save() {
  local ssid="${1:-}"
  local password="${2:-}"
  local band="${3:-bg}"
  local channel="${4:-0}"
  local security="${5:-wpa-psk}"
  local upstream_pref="${6:-auto}"

  [[ -n "$ssid" ]] || { echo '{"error": "SSID is required"}' >&2; exit 1; }
  save_config "$ssid" "$password" "$band" "$channel" "$security" "$upstream_pref"
  cmd_status
}

# Set upstream preference directly
cmd_set_upstream() {
  local pref="${1:-auto}"
  local ssid
  ssid=$(get_config "ssid" "Omarchy-Hotspot")
  local pw
  pw=$(get_config "password" "omarchy1234")
  local band
  band=$(get_config "band" "bg")
  local chan
  chan=$(get_config "channel" "0")
  local sec
  sec=$(get_config "security" "wpa-psk")
  save_config "$ssid" "$pw" "$band" "$chan" "$sec" "$pref"
  cmd_status
}

# Main routing
action="${1:-status}"
shift || true

case "$action" in
  status)
    cmd_status
    ;;
  start)
    cmd_start "$@"
    ;;
  stop)
    cmd_stop
    ;;
  toggle)
    cmd_toggle
    ;;
  clients)
    ap_iface=$(get_ap_iface)
    get_clients "$ap_iface"
    ;;
  qr)
    ssid=$(get_config "ssid" "Omarchy-Hotspot")
    pw=$(get_config "password" "omarchy1234")
    sec=$(get_config "security" "wpa-psk")
    generate_qr_matrix "$ssid" "$pw" "$sec"
    ;;
  save|save-config)
    cmd_save "$@"
    ;;
  set-upstream)
    cmd_set_upstream "$@"
    ;;
  *)
    echo "Usage: $0 {status|start|stop|toggle|clients|qr|save|set-upstream} [args...]" >&2
    exit 1
    ;;
esac
