#!/bin/bash

# omarchy:summary=Wi-Fi Hotspot & Internet Sharing/Repeater backend for Omarchy
# omarchy:group=hotspot
# omarchy:args=[status|start|stop|toggle|clients|qr|save|set-upstream]

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
CONFIG_FILE="$CONFIG_DIR/hotspot.json"
PROFILE_NAME="OmarchyHotspot"
AP_HELPER="/usr/local/bin/omarchy-hotspot-ap-helper"

# Ensure config directory exists with strict permissions
mkdir -p "$CONFIG_DIR"
chmod 0700 "$CONFIG_DIR" 2>/dev/null || true

# Repair existing config file permissions if present
if [[ -f "$CONFIG_FILE" ]]; then
  chmod 0600 "$CONFIG_FILE" 2>/dev/null || true
fi

# Default configuration getter
get_config() {
  local key="$1"
  local default_val="$2"
  if [[ -f "$CONFIG_FILE" ]]; then
    chmod 0600 "$CONFIG_FILE" 2>/dev/null || true
    val=$(jq -r --arg k "$key" '.[$k] // empty' "$CONFIG_FILE" 2>/dev/null || true)
    if [[ -n "$val" ]]; then
      echo "$val"
      return
    fi
  fi
  echo "$default_val"
}

# Save configuration atomically with mode 0600
save_config() {
  local ssid="$1"
  local password="$2"
  local band="${3:-bg}"
  local channel="${4:-0}"
  local security="${5:-wpa-psk}"
  local upstream_pref="${6:-auto}"

  mkdir -p "$CONFIG_DIR"
  chmod 0700 "$CONFIG_DIR" 2>/dev/null || true

  local tmp_file
  tmp_file=$(
    umask 077
    mktemp "$CONFIG_DIR/hotspot.json.tmp.XXXXXX"
  )
  chmod 0600 "$tmp_file"

  jq -n \
    --arg ssid "$ssid" \
    --arg password "$password" \
    --arg band "$band" \
    --arg channel "$channel" \
    --arg security "$security" \
    --arg upstream_pref "$upstream_pref" \
    '{
      ssid: $ssid,
      password: $password,
      band: $band,
      channel: $channel,
      security: $security,
      upstream_preference: $upstream_pref
    }' > "$tmp_file"

  mv -f "$tmp_file" "$CONFIG_FILE"
  chmod 0600 "$CONFIG_FILE"
}

# Find primary Wi-Fi interface (STA client)
get_primary_wifi() {
  local iface
  iface=$(iw dev 2>/dev/null | awk '$1 == "Interface" && $2 ~ /^wl/ { print $2; exit }')
  if [[ -z "$iface" ]]; then
    iface=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" && $1 ~ /^wl/ { print $1; exit }')
  fi
  echo "${iface:-wlo1}"
}

# Find or ensure AP interface name
get_ap_iface() {
  if ip link show ap0 >/dev/null 2>&1; then
    echo "ap0"
    return
  fi
  local p
  p=$(get_primary_wifi)
  echo "${p:-wlo1}"
}

# Lifecycle helper for virtual AP interface (ap0)
ensure_ap0_created() {
  if ip link show ap0 >/dev/null 2>&1; then
    return 0
  fi
  if [[ -x "$AP_HELPER" ]]; then
    sudo -n "$AP_HELPER" add 2>/dev/null || true
  else
    sudo -n iw phy phy0 interface add ap0 type __ap 2>/dev/null || true
    sudo -n ip link set ap0 up 2>/dev/null || true
  fi
  sleep 0.5
}

ensure_ap0_deleted() {
  if ! ip link show ap0 >/dev/null 2>&1; then
    return 0
  fi
  if [[ -x "$AP_HELPER" ]]; then
    sudo -n "$AP_HELPER" del 2>/dev/null || true
  else
    sudo -n iw dev ap0 del 2>/dev/null || true
  fi
}

# Detect upstream internet connection details
get_upstream_info() {
  local pref
  pref=$(get_config "upstream_preference" "auto")
  
  local eth_iface
  eth_iface=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: '$2 == "ethernet" && $3 ~ /^connected/ { print $1; exit }')
  local eth_ip=""
  [[ -n "$eth_iface" ]] && eth_ip=$(ip -4 addr show dev "$eth_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')

  local wifi_iface
  wifi_iface=$(get_primary_wifi)
  local wifi_connected=false
  local wifi_ssid=""
  local wifi_ip=""
  if iw dev "$wifi_iface" info 2>/dev/null | grep -q "type managed"; then
    wifi_ssid=$(iw dev "$wifi_iface" info 2>/dev/null | awk '$1 == "ssid" { print $2; exit }')
    if [[ -z "$wifi_ssid" ]]; then
      wifi_ssid=$(nmcli -t -f DEVICE,CONNECTION device status 2>/dev/null | awk -F: -v dev="$wifi_iface" '$1 == dev && $2 != "" && $2 != "--" { print $2; exit }')
    fi
    if [[ -n "$wifi_ssid" ]]; then
      wifi_connected=true
      wifi_ip=$(ip -4 addr show dev "$wifi_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')
    fi
  fi

  local active_type="none"
  local active_iface=""
  local active_ip=""
  local active_name=""

  if [[ "$pref" == "ethernet" && -n "$eth_iface" ]]; then
    active_type="ethernet"
    active_iface="$eth_iface"
    active_ip="$eth_ip"
    active_name="Ethernet ($eth_iface)"
  elif [[ "$pref" == "wifi" && "$wifi_connected" == "true" ]]; then
    active_type="wifi"
    active_iface="$wifi_iface"
    active_ip="$wifi_ip"
    active_name="$wifi_ssid"
  else
    # Auto mode: check default route
    local def_route_dev
    def_route_dev=$(ip route show default 2>/dev/null | awk '$1 == "default" { print $5; exit }')
    if [[ -n "$def_route_dev" && "$def_route_dev" == "$eth_iface" ]]; then
      active_type="ethernet"
      active_iface="$eth_iface"
      active_ip="$eth_ip"
      active_name="Ethernet ($eth_iface)"
    elif [[ -n "$def_route_dev" && "$def_route_dev" == "$wifi_iface" && "$wifi_connected" == "true" ]]; then
      active_type="wifi"
      active_iface="$wifi_iface"
      active_ip="$wifi_ip"
      active_name="$wifi_ssid"
    elif [[ -n "$eth_iface" ]]; then
      active_type="ethernet"
      active_iface="$eth_iface"
      active_ip="$eth_ip"
      active_name="Ethernet ($eth_iface)"
    elif [[ "$wifi_connected" == "true" ]]; then
      active_type="wifi"
      active_iface="$wifi_iface"
      active_ip="$wifi_ip"
      active_name="$wifi_ssid"
    fi
  fi

  jq -n \
    --arg type "$active_type" \
    --arg iface "$active_iface" \
    --arg ip "$active_ip" \
    --arg name "$active_name" \
    '{
      type: $type,
      interface: $iface,
      ip: $ip,
      name: $name
    }'
}

# Build dynamic upstreams list containing only active/connected interfaces
get_dynamic_upstreams_json() {
  local pref
  pref=$(get_config "upstream_preference" "auto")
  
  # Always include Auto
  local items='[{"id":"auto","label":"Automático (Recomendado)","available":true,"selected":'$( [[ "$pref" == "auto" ]] && echo "true" || echo "false" )'}'

  # Ethernet check
  local eth_iface
  eth_iface=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: '$2 == "ethernet" && $3 ~ /^connected/ { print $1; exit }')
  if [[ -n "$eth_iface" ]]; then
    items+=',{"id":"ethernet","label":"Ethernet ('"$eth_iface"')","available":true,"selected":'$( [[ "$pref" == "ethernet" ]] && echo "true" || echo "false" )'}'
  fi

  # Wi-Fi check
  local wifi_iface
  wifi_iface=$(get_primary_wifi)
  if iw dev "$wifi_iface" info 2>/dev/null | grep -q "type managed"; then
    local wifi_ssid
    wifi_ssid=$(iw dev "$wifi_iface" info 2>/dev/null | awk '$1 == "ssid" { print $2; exit }')
    if [[ -z "$wifi_ssid" ]]; then
      wifi_ssid=$(nmcli -t -f DEVICE,CONNECTION device status 2>/dev/null | awk -F: -v dev="$wifi_iface" '$1 == dev && $2 != "" && $2 != "--" { print $2; exit }')
    fi
    if [[ -n "$wifi_ssid" ]]; then
      items+=',{"id":"wifi","label":"Wi-Fi ('"$wifi_ssid"')","available":true,"selected":'$( [[ "$pref" == "wifi" ]] && echo "true" || echo "false" )'}'
    fi
  fi

  items+=']'
  echo "$items"
}

# Check if hotspot profile is currently active
is_hotspot_active() {
  # Check if NetworkManager active connection list has OmarchyHotspot
  if nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null | grep -q "^${PROFILE_NAME}:802-11-wireless:activated"; then
    return 0
  fi
  # Also check if an AP-mode interface is currently running the profile
  local ap_dev
  ap_dev=$(nmcli -t -f DEVICE,TYPE,CONNECTION device status 2>/dev/null | awk -F: -v p="$PROFILE_NAME" '$2 == "wifi" && $3 == p { print $1; exit }')
  if [[ -n "$ap_dev" ]]; then
    return 0
  fi
  return 1
}

# Generate QR Matrix (square 0/1 array for QML)
generate_qr_matrix() {
  local ssid="$1"
  local password="$2"
  local security="${3:-wpa-psk}"

  local auth_type="WPA"
  if [[ "$security" == "open" || -z "$password" ]]; then
    auth_type="nopass"
  fi

  # Format: WIFI:T:WPA;S:MySSID;P:MyPassword;;
  local payload
  if [[ "$auth_type" == "nopass" ]]; then
    payload="WIFI:T:nopass;S:${ssid};;"
  else
    # Escape special chars: \ ; , :
    esc_ssid=$(printf '%s' "$ssid" | sed -e 's/\\/\\\\/g' -e 's/;/\\;/g' -e 's/,/\\,/g' -e 's/:/\\:/g')
    esc_pw=$(printf '%s' "$password" | sed -e 's/\\/\\\\/g' -e 's/;/\\;/g' -e 's/,/\\,/g' -e 's/:/\\:/g')
    payload="WIFI:T:${auth_type};S:${esc_ssid};P:${esc_pw};;"
  fi

  if ! command -v qrencode >/dev/null 2>&1; then
    echo '{"size": 0, "rows": [], "payload": "'"$payload"'"}'
    return
  fi

  # Generate ASCII QR: each module is represented by 2 chars
  local ascii_qr
  ascii_qr=$(qrencode -m 2 -t ASCII "$payload" 2>/dev/null || true)
  if [[ -z "$ascii_qr" ]]; then
    echo '{"size": 0, "rows": [], "payload": "'"$payload"'"}'
    return
  fi

  local -a rows=()
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      local row_bits=""
      for (( col=0; col<${#line}; col+=2 )); do
        if [[ "${line:col:2}" == *"#"* ]]; then
          row_bits+="1"
        else
          row_bits+="0"
        fi
      done
      rows+=("\"$row_bits\"")
    fi
  done <<< "$ascii_qr"

  local size=${#rows[@]}
  local rows_json="["
  for (( i=0; i<size; i++ )); do
    rows_json+="${rows[i]}"
    if (( i < size - 1 )); then rows_json+=","; fi
  done
  rows_json+="]"

  echo '{"size": '"$size"', "rows": '"$rows_json"', "payload": "'"$payload"'"}'
}

# Get list of connected clients
get_clients() {
  local iface="$1"
  local clients_json="[]"

  if ! ip link show "$iface" >/dev/null 2>&1; then
    echo "$clients_json"
    return
  fi

  local -a macs=()
  local -A signal_map=()
  local -A rx_map=()
  local -A tx_map=()
  local -A time_map=()

  # Parse iw station dump
  local cur_mac=""
  while IFS= read -r line; do
    if [[ "$line" =~ ^Station[[:space:]]+([0-9a-fA-F:]{17}) ]]; then
      cur_mac="${BASH_REMATCH[1]}"
      macs+=("$cur_mac")
    elif [[ -n "$cur_mac" ]]; then
      if [[ "$line" =~ signal:[[:space:]]+(-?[0-9]+) ]]; then
        signal_map["$cur_mac"]="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ rx[[:space:]]bytes:[[:space:]]+([0-9]+) ]]; then
        rx_map["$cur_mac"]="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ tx[[:space:]]bytes:[[:space:]]+([0-9]+) ]]; then
        tx_map["$cur_mac"]="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ connected[[:space:]]time:[[:space:]]+([0-9]+) ]]; then
        time_map["$cur_mac"]="${BASH_REMATCH[1]}"
      fi
    fi
  done < <(iw dev "$iface" station dump 2>/dev/null || true)

  if [[ ${#macs[@]} -eq 0 ]]; then
    echo "$clients_json"
    return
  fi

  local -A ip_map=()
  local -A name_map=()

  # Map IPv4 from arp / ip neigh
  while IFS= read -r line; do
    local ip mac
    ip=$(echo "$line" | awk '{print $1}')
    mac=$(echo "$line" | awk '{print $5}')
    if [[ -n "$mac" && -n "$ip" && "$mac" =~ ^[0-9a-fA-F:]{17}$ ]]; then
      ip_map["$mac"]="$ip"
    fi
  done < <(ip -4 neigh show dev "$iface" 2>/dev/null || true)

  # Fallback pass for any remaining
  if [[ -r /proc/net/arp ]]; then
    while IFS= read -r line; do
      local ip mac dev
      ip=$(echo "$line" | awk '{print $1}')
      mac=$(echo "$line" | awk '{print $4}')
      dev=$(echo "$line" | awk '{print $6}')
      if [[ "$dev" == "$iface" && -n "$mac" && -n "$ip" && "$mac" =~ ^[0-9a-fA-F:]{17}$ ]]; then
        [[ -z "${ip_map[$mac]:-}" ]] && ip_map["$mac"]="$ip"
      fi
    done < <(tail -n +2 /proc/net/arp 2>/dev/null || true)
  fi

  # Resolve hostnames
  for mac in "${macs[@]}"; do
    local ip="${ip_map[$mac]:-}"
    local name=""
    if [[ -n "$ip" ]]; then
      name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}' || true)
      if [[ -z "$name" && -r /var/lib/NetworkManager/dnsmasq-${iface}.leases ]]; then
        name=$(awk -v m="$mac" '$2 == tolower(m) {print $4}' "/var/lib/NetworkManager/dnsmasq-${iface}.leases" 2>/dev/null || true)
      fi
    fi
    name_map["$mac"]="${name:-Dispositivo}"
  done

  # Build JSON output
  local out="["
  local count=0
  for mac in "${macs[@]}"; do
    local ip="${ip_map[$mac]:-Desconocida}"
    local name="${name_map[$mac]:-Dispositivo}"
    local sig="${signal_map[$mac]:--65}"
    local rx="${rx_map[$mac]:-0}"
    local tx="${tx_map[$mac]:-0}"
    local t="${time_map[$mac]:-0}"

    (( count > 0 )) && out+=","
    out+=$(jq -n \
      --arg mac "$mac" \
      --arg ip "$ip" \
      --arg name "$name" \
      --argjson signal "$sig" \
      --argjson rx_bytes "$rx" \
      --argjson tx_bytes "$tx" \
      --argjson connected_seconds "$t" \
      '{
        mac: $mac,
        ip: $ip,
        hostname: $name,
        signal: $signal,
        rx_bytes: $rx_bytes,
        tx_bytes: $tx_bytes,
        connected_seconds: $connected_seconds
      }')
    (( count++ ))
  done
  out+="]"

  echo "$out"
}

# Output complete JSON status
cmd_status() {
  local active=false
  local ap_iface
  ap_iface=$(get_ap_iface)
  local client_count=0
  local clients_json="[]"
  local ip_addr="10.42.0.1"

  if is_hotspot_active; then
    active=true
    local actual_ip
    actual_ip=$(ip -4 addr show dev "$ap_iface" 2>/dev/null | awk '$1 == "inet" { split($2, a, "/"); print a[1]; exit }')
    [[ -n "$actual_ip" ]] && ip_addr="$actual_ip"

    clients_json=$(get_clients "$ap_iface")
    client_count=$(echo "$clients_json" | jq '. | length' 2>/dev/null || echo "0")
  fi

  local conf_ssid conf_pw conf_band conf_channel conf_sec conf_upstream
  conf_ssid=$(get_config "ssid" "Omarchy-Hotspot")
  conf_pw=$(get_config "password" "omarchy1234")
  conf_band=$(get_config "band" "bg")
  conf_channel=$(get_config "channel" "0")
  conf_sec=$(get_config "security" "wpa-psk")
  conf_upstream=$(get_config "upstream_preference" "auto")

  local upstream_json
  upstream_json=$(get_upstream_info)

  local dynamic_upstreams_json
  dynamic_upstreams_json=$(get_dynamic_upstreams_json)

  local qr_json
  qr_json=$(generate_qr_matrix "$conf_ssid" "$conf_pw" "$conf_sec")

  jq -n \
    --argjson active "$active" \
    --arg ssid "$conf_ssid" \
    --arg password "$conf_pw" \
    --arg band "$conf_band" \
    --arg channel "$conf_channel" \
    --arg security "$conf_sec" \
    --arg upstream_pref "$conf_upstream" \
    --arg iface "$ap_iface" \
    --arg ip "$ip_addr" \
    --argjson upstream "$upstream_json" \
    --argjson upstreams "$dynamic_upstreams_json" \
    --argjson clients_count "$client_count" \
    --argjson clients "$clients_json" \
    --argjson qr "$qr_json" \
    '{
      active: $active,
      ssid: $ssid,
      password: $password,
      band: $band,
      channel: $channel,
      security: $security,
      upstream_preference: $upstream_pref,
      interface: $iface,
      ip: $ip,
      upstream: $upstream,
      upstreams: $upstreams,
      clients_count: $clients_count,
      clients: $clients,
      qr: $qr
    }'
}

# Start Hotspot
cmd_start() {
  local ssid="${1:-}"
  local band="${2:-}"
  local channel="${3:-}"
  local security="${4:-}"
  local upstream_pref="${5:-}"

  # Read PSK from stdin if piped/provided, or fallback to saved config
  local password=""
  if [[ ! -t 0 ]]; then
    IFS= read -r input_pwd || true
    password="$input_pwd"
  fi

  [[ -z "$ssid" ]] && ssid=$(get_config "ssid" "Omarchy-Hotspot")
  [[ -z "$password" ]] && password=$(get_config "password" "omarchy1234")
  [[ -z "$band" ]] && band=$(get_config "band" "bg")
  [[ -z "$channel" ]] && channel=$(get_config "channel" "0")
  [[ -z "$security" ]] && security=$(get_config "security" "wpa-psk")
  [[ -z "$upstream_pref" ]] && upstream_pref=$(get_config "upstream_preference" "auto")

  save_config "$ssid" "$password" "$band" "$channel" "$security" "$upstream_pref"

  # Ensure Wi-Fi radio is unblocked and powered on
  if rfkill list wifi 2>/dev/null | grep -q "Soft blocked: yes"; then
    rfkill unblock wifi >/dev/null 2>&1 || true
    sleep 0.5
  fi
  if ! nmcli radio wifi 2>/dev/null | grep -q "enabled"; then
    nmcli radio wifi on >/dev/null 2>&1 || true
    sleep 0.5
  fi

  local primary_wifi
  primary_wifi=$(get_primary_wifi)

  # Check if primary wifi is currently connected to an upstream network
  local sta_channel=""
  local sta_band=""
  local is_dfs=false
  if iw dev "$primary_wifi" info 2>/dev/null | grep -q "type managed"; then
    sta_channel=$(iw dev "$primary_wifi" info 2>/dev/null | awk '$1 == "channel" { print $2; exit }')
    if [[ -n "$sta_channel" && "$sta_channel" =~ ^[0-9]+$ ]]; then
      if (( sta_channel > 14 )); then
        sta_band="a"
        if (( sta_channel >= 52 && sta_channel <= 144 )); then
          is_dfs=true
        fi
      else
        sta_band="bg"
      fi
    fi
  fi

  local target_channel="$channel"
  local target_band="$band"
  if [[ -n "$sta_channel" ]]; then
    if [[ "$is_dfs" == "true" ]]; then
      target_channel="6"
      target_band="bg"
    else
      target_channel="$sta_channel"
      target_band="$sta_band"
    fi
  fi

  # Ensure virtual AP interface (ap0) exists on phy0 via root helper
  ensure_ap0_created

  local ap_iface
  if ip link show ap0 >/dev/null 2>&1; then
    ap_iface="ap0"
  else
    ap_iface=$(get_primary_wifi)
  fi

  # Remove existing profile if any
  if nmcli connection show id "$PROFILE_NAME" >/dev/null 2>&1; then
    nmcli connection delete id "$PROFILE_NAME" >/dev/null 2>&1 || true
  fi

  # Build nmcli arguments without password in argv
  local -a nm_args=(
    type wifi
    ifname "$ap_iface"
    con-name "$PROFILE_NAME"
    autoconnect no
    ssid "$ssid"
    mode ap
  )

  if [[ "$target_band" == "a" || "$target_band" == "bg" || "$target_band" == "6GHz" ]]; then
    nm_args+=(802-11-wireless.band "$target_band")
  fi

  if [[ -n "$target_channel" && "$target_channel" != "0" && "$target_channel" != "auto" ]]; then
    nm_args+=(802-11-wireless.channel "$target_channel")
  fi

  if [[ "$security" == "open" || -z "$password" ]]; then
    nm_args+=(
      ipv4.method shared
      ipv6.method ignore
    )
    nmcli connection add "${nm_args[@]}" >/dev/null
  else
    nm_args+=(
      802-11-wireless-security.key-mgmt wpa-psk
      802-11-wireless-security.proto rsn
      802-11-wireless-security.pairwise ccmp
      802-11-wireless-security.group ccmp
      802-11-wireless-security.pmf 1
      ipv4.method shared
      ipv6.method ignore
    )
    nmcli connection add "${nm_args[@]}" >/dev/null
    # Pass password via stdin to nmcli connection edit (never in argv)
    printf "set 802-11-wireless-security.psk %s\nsave\nquit\n" "$password" | nmcli connection edit "$PROFILE_NAME" >/dev/null 2>&1
  fi

  # Bring connection up on ap0
  nmcli connection up id "$PROFILE_NAME" >/dev/null

  cmd_status
}

# Stop Hotspot
cmd_stop() {
  if is_hotspot_active; then
    nmcli connection down id "$PROFILE_NAME" >/dev/null 2>&1 || true
  fi
  if nmcli connection show id "$PROFILE_NAME" >/dev/null 2>&1; then
    nmcli connection delete id "$PROFILE_NAME" >/dev/null 2>&1 || true
  fi
  # Cleanly delete virtual interface ap0 via root helper
  ensure_ap0_deleted
  cmd_status
}

# Toggle Hotspot
cmd_toggle() {
  if is_hotspot_active; then
    cmd_stop
  else
    cmd_start
  fi
}

# Save configuration
cmd_save() {
  local ssid="${1:-}"
  local band="${2:-bg}"
  local channel="${3:-0}"
  local security="${4:-wpa-psk}"
  local upstream_pref="${5:-auto}"

  # Read PSK from stdin if piped/provided, or fallback to saved config
  local password=""
  if [[ ! -t 0 ]]; then
    IFS= read -r input_pwd || true
    password="$input_pwd"
  fi

  [[ -n "$ssid" ]] || { echo '{"error": "SSID is required"}' >&2; exit 1; }
  [[ -z "$password" ]] && password=$(get_config "password" "omarchy1234")

  save_config "$ssid" "$password" "$band" "$channel" "$security" "$upstream_pref"
  cmd_status
}

# Set upstream preference directly
cmd_set_upstream() {
  local pref="${1:-auto}"
  local ssid
  ssid=$(get_config "ssid" "Omarchy-Hotspot")
  local pw
  pw=$(get_config "password" "omarchy1234")
  local band
  band=$(get_config "band" "bg")
  local chan
  chan=$(get_config "channel" "0")
  local sec
  sec=$(get_config "security" "wpa-psk")
  save_config "$ssid" "$pw" "$band" "$chan" "$sec" "$pref"
  cmd_status
}

# Main routing
action="${1:-status}"
shift || true

case "$action" in
  status)
    cmd_status
    ;;
  start)
    cmd_start "$@"
    ;;
  stop)
    cmd_stop
    ;;
  toggle)
    cmd_toggle
    ;;
  clients)
    ap_iface=$(get_ap_iface)
    get_clients "$ap_iface"
    ;;
  qr)
    ssid=$(get_config "ssid" "Omarchy-Hotspot")
    pw=$(get_config "password" "omarchy1234")
    sec=$(get_config "security" "wpa-psk")
    generate_qr_matrix "$ssid" "$pw" "$sec"
    ;;
  save|save-config)
    cmd_save "$@"
    ;;
  set-upstream)
    cmd_set_upstream "$@"
    ;;
  *)
    echo "Usage: $0 {status|start|stop|toggle|clients|qr|save|set-upstream} [args...]" >&2
    exit 1
    ;;
esac
